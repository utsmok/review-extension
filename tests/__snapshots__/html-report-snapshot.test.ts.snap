exports[`HTML report snapshot > matches snapshot for partially-scored session 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:;">
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>TRUST Review: PartialTool</title>
<style></style>
</head>
<body>

<main id="report-content">


<div class="nutrition-label">
  <div class="trust-branding">
    <img src="data:image/png;base64," alt="TRUST" />
    <div class="trust-branding-tagline">Information Tool Reviews</div>
  </div>
  <div class="nutrition-divider"></div>

  <div class="nutrition-header">
    <div class="nutrition-header-center">
      <div class="nutrition-header-line">
        
        
        <a href="https://testsearch.example.com" target="_blank" rel="noopener noreferrer"><span class="nutrition-tool-name">PartialTool</span></a>
        <span class="nutrition-sep">&middot;</span>
        <span class="nutrition-tool-url"><a href="https://testsearch.example.com" rel="noopener noreferrer" target="_blank" >https://testsearch.example.com</a></span>
