{
  "name": "trust-review-extension",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "report:dev": "vite --config report-dev/vite.config.ts",
    "report:build": "vite build --config report-dev/vite.config.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "clean": "wxt clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:e2e": "playwright test",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "release": "node scripts/release.mjs",
    "sync-registry": "node scripts/sync-registry.mjs",
    "prebuild": "node scripts/sync-registry.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "^5.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@codspeed/vitest-plugin": "^5.4.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "wxt": "^0.20.0"
  }
}
